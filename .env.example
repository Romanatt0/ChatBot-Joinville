# Copie para .env e preencha (o .env NÃO vai para o git).
#   cp .env.example .env

# local = Chroma + Ollama disponível | cloud = Qdrant Cloud, sem Ollama
MODO=local

# Chaves dos provedores (opcionais no modo local: também dá para digitar na barra lateral)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Qdrant Cloud: necessário no MODO=cloud e para `python ingestao.py --destino qdrant`
QDRANT_URL=
QDRANT_API_KEY=

# Servidor MCP (https://github.com/Romanatt0/MCP-SERVER)
MCP_URL=http://localhost:8000/mcp

# Opcionais
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2   # mudou? rode ingestao.py de novo
# COLLECTION_NAME=chatville
# RETRIEVER_K=3
# HISTORY_LIMIT=10
