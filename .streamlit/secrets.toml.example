# Modelo dos secrets do Streamlit Community Cloud.
# No deploy: Settings → Secrets → cole este conteúdo preenchido.
# Para testar o modo cloud localmente, copie para .streamlit/secrets.toml (NÃO vai para o git).

MODO = "cloud"

# Chave do Groq usada quando o visitante não informa a dele.
# Atenção: qualquer pessoa com o link do app usa a cota desta chave.
GROQ_API_KEY = "gsk_..."

# Qdrant Cloud (cluster com a coleção criada por `python ingestao.py --destino qdrant`)
QDRANT_URL = "https://xxxxxxxx.cloud.qdrant.io"
QDRANT_API_KEY = "..."

# Opcional: URL PÚBLICA do servidor MCP. Sem ela, a previsão do tempo fica desativada.
# MCP_URL = "https://seu-servidor-mcp.exemplo.com/mcp"

# Não coloque chaves de OpenAI/Anthropic aqui: no modo cloud o app não as usa
# (ficariam disponíveis para qualquer visitante). Cada usuário informa a sua.
